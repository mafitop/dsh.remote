# 复制到 .signing/signing.env（该目录已被 .gitignore 排除，不会入库）
#
# 三份材料 + 这里的密码：
#   .signing/store.p12
#   .signing/certificate.cer
#   .signing/profile.p7b
#
# 也可以用绝对路径覆盖默认位置：
# STORE_FILE=/path/to/store.p12
# CERT_FILE=/path/to/certificate.cer
# PROFILE_FILE=/path/to/profile.p7b

STORE_PASSWORD=''
KEY_PASSWORD=''
KEY_ALIAS='debugKey'

# 可选：签名算法（ECC 证书用 SHA256withECDSA，RSA 证书用 SHA256withRSA）
# SIGN_ALG='SHA256withECDSA'
