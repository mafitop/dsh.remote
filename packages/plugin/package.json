{
  "name": "dsh-remote-plugin",
  "version": "0.8.3",
  "description": "DSH Remote 官方 bundle 插件：更多菜单中的手机连接入口、首次连接提示与浏览器管理控制台；内置网关自动启停，支持手机远程会话、审批、文件互传和设备管理。",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "cordis.patch.yml",
    "*.md",
    "plugin-center.mjs",
    "plugin-transaction.mjs",
    "market.mjs",
    "insights.mjs",
    "teams.mjs",
    "task-board.mjs",
    "peak-reminders.mjs",
    "skills.mjs",
    "file-delivery.mjs",
    "session-file.mjs"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "bundle",
    "remote-control",
    "mobile"
  ],
  "license": "MIT",
  "homepage": "https://repo.yaowan.fun/fayhot/dsh.remote",
  "repository": {
    "type": "git",
    "url": "git+https://repo.yaowan.fun/fayhot/dsh.remote.git",
    "directory": "packages/plugin"
  },
  "bugs": {
    "url": "https://repo.yaowan.fun/fayhot/dsh.remote/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
